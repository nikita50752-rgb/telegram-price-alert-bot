# Copy this file to .env and fill in your values. Never publish .env!
BOT_TOKEN=123456789:replace-with-token-from-BotFather
# How often prices are checked, seconds (min 30; free CoinGecko API allows ~30 requests/min)
CHECK_SECONDS=60
# Quote currency: usd, eur, rub, ...
CURRENCY=usd
MAX_ALERTS_PER_USER=20
